"""krabka-broker — Bazel module (bzlmod).

Bazel is the build and test path; Cargo stays the dependency source of truth.
`crate.from_cargo` reads the same `Cargo.toml` / `Cargo.lock` that Cargo does,
so there is no second dependency set to keep in sync.
"""

module(
    name = "krabka_streams_rs",
    version = "0.4.0",
)

bazel_dep(name = "rules_rs", version = "0.0.106")
bazel_dep(name = "rules_rs_mutants", version = "0.0.1")

# rules_rs_mutants is not published to the Bazel Central Registry, so the
# `bazel_dep` above has nothing to resolve against without this override.
git_override(
    module_name = "rules_rs_mutants",
    # Resolved to a commit so the checkout is reproducible. Past v0.0.1 for
    # `//mutants:config`, without which the sweep enumerates from a synthetic
    # workspace where this repo's `.cargo/mutants.toml` is not in scope -- so the
    # exclusions written there did not exclude.
    commit = "fd8902e425382aaa58490c22721f563127ab9467",
    remote = "https://github.com/robot-head/rules_rs_mutants",
)

# A hermetic C++ toolchain rather than the host's.
#
# Bazel's autodetected toolchain links with whatever the machine happens to have.
# GitHub's runners carry `ld.gold`, so it passed `-fuse-ld=gold` and every link
# action printed "the gold linker is deprecated and has known bugs with Rust" --
# hundreds of lines per CI run, from a linker choice nothing here made. Pinning
# the toolchain links with lld instead, makes a local build and a CI build the
# same build, and is what rules_rs_mutants needs on macOS, where Xcode's
# cc_wrapper leaves a mutant link without `DEVELOPER_DIR`.
bazel_dep(name = "llvm", version = "0.8.18")

register_toolchains("@llvm//toolchain:all")

# ---------------------------------------------------------------------------
# Kafka images for the container-driven suites.
#
# Pinned by digest and fetched by Bazel, so a test loads known bytes from the
# repository cache instead of pulling a mutable tag over the network mid-run.
# See //bazel/images, which turns each into a `docker load`-able tarball.
# ---------------------------------------------------------------------------
# `protoc` for the crates that generate prost types. Supplied by the build so
# no crate has to vendor a binary and locate it through its own manifest path.
bazel_dep(name = "protobuf", version = "27.0")

# `sh_test`, for the wrapper that loads those images before a suite runs.
bazel_dep(name = "rules_shell", version = "0.8.0")

# ---------------------------------------------------------------------------
# Format and lint. See //tools/format and //tools/lint.
# ---------------------------------------------------------------------------
bazel_dep(name = "aspect_rules_lint", version = "2.7.2")

# Supplies a clippy aspect shaped the way `aspect lint` expects -- it writes the
# `rules_lint_machine` output group, which the aspect from @rules_rust does not.
# It also registers a Rust toolchain of its own, pinned to 1.92.0 / edition 2021
# for its own tests; see the toolchain block below for how the two coexist.
bazel_dep(name = "aspect_rules_lint_rust", version = "0.0.2")

# See the patch header: that module registers `@default_rust_toolchains//:all`,
# a package rules_rs 0.0.106 does not create.
single_version_override(
    module_name = "aspect_rules_lint_rust",
    patch_strip = 1,
    patches = ["//bazel/patches:aspect-rules-lint-rust-toolchain-pattern.patch"],
    version = "0.0.2",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")

# rules_rs vends its own patched @rules_rust. `rust_doc_test` has no rules_rs
# wrapper, so it is loaded from there directly rather than from a second copy.
rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

# ---------------------------------------------------------------------------
# Rust toolchain — pinned to the same channel as rust-toolchain.toml.
# ---------------------------------------------------------------------------
toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")

# Named rather than left as `default_rust_toolchains`, which
# aspect_rules_lint_rust also claims: rules_rs refuses two configurations under
# one repo name, and that module wants 1.92.0 / edition 2021 while this
# repository is 1.97.1 / edition 2024. Both toolchains get registered; ours is
# registered from the root module, which is what makes it the one that resolves.
toolchains.toolchain(
    name = "krabka_rust_toolchains",
    edition = "2024",
    # rustfmt.toml sets `format_code_in_doc_comments`, `group_imports` and
    # `imports_granularity`, all still nightly-gated. Stable rustfmt does not
    # fail on them, it warns and silently skips them -- so a stable formatter
    # would quietly disagree with the tree, which CI formats with
    # `cargo +nightly fmt`. rules_rs pins rustfmt separately from rustc for
    # exactly this.
    rustfmt_version = "nightly/2026-08-14",
    # Matches rust-toolchain.toml. These had drifted apart -- Bazel built with
    # 1.97.0 while Cargo used 1.97.1 -- which is precisely the split the "one
    # dependency source of truth" arrangement exists to avoid.
    version = "1.97.1",
)
use_repo(toolchains, "krabka_rust_toolchains")

register_toolchains("@krabka_rust_toolchains//...")

# ---------------------------------------------------------------------------
# Third-party crates, resolved from the Cargo workspace.
# ---------------------------------------------------------------------------
PLATFORM_TRIPLES = [
    "aarch64-apple-darwin",
    "aarch64-unknown-linux-gnu",
    "x86_64-apple-darwin",
    "x86_64-unknown-linux-gnu",
]

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# rules_rs_mutants deliberately ships no cargo-mutants binary: every consumer
# builds one from its own lockfile so the sweep and the build agree on a
# version. `//tools/mutants` is that lockfile.
crate.from_cargo(
    name = "mutants",
    cargo_lock = "//tools/mutants:Cargo.lock",
    cargo_toml = "//tools/mutants:Cargo.toml",
    platform_triples = PLATFORM_TRIPLES,
)

# The wire-layer and client crates come from two sibling repositories, each a
# Cargo workspace whose `members` is the glob `crates/*`. rules_rs resolves a git
# crate's directory by matching the crate name against the members list, and it
# skips glob entries, so each member's path is named here instead.
SIBLING_MEMBERS = {
    "crabka-audit": "crates/audit",
    "crabka-authz": "crates/authz",
    "crabka-broker": "crates/broker",
    "crabka-client-admin": "crates/client-admin",
    "crabka-client-consumer": "crates/client-consumer",
    "crabka-client-core": "crates/client-core",
    "crabka-client-producer": "crates/client-producer",
    "crabka-compression": "crates/compression",
    "crabka-ids": "crates/ids",
    "crabka-kraft-core": "crates/kraft-core",
    "crabka-log": "crates/log",
    "crabka-logfmt": "crates/logfmt",
    "crabka-metadata": "crates/metadata",
    "crabka-object-store": "crates/object-store",
    "crabka-raft": "crates/raft",
    "crabka-records-legacy": "crates/records-legacy",
    "crabka-remote-storage": "crates/remote-storage",
    "crabka-remote-storage-topic": "crates/remote-storage-topic",
    "crabka-security": "crates/security",
    "crabka-telemetry": "crates/telemetry",
    "crabka-throttle": "crates/throttle",
    "crabka-trace-context": "crates/trace-context",
    "crabka-units": "crates/units",
    "crabka-verified": "crates/verified",
    "crabka-voters": "crates/voters",
}

[
    crate.annotation(
        crate = crate_name,
        strip_prefix = directory,
        workspace_cargo_toml = "Cargo.toml",
    )
    for crate_name, directory in SIBLING_MEMBERS.items()
]

# crabka-protocol carries the same member annotation plus one more. Its build.rs
# only checks that its checked-in `generated/`
# sources still match the `schemas/` SHAs; it emits no code. It reads its own
# manifest directory through `env!("CARGO_MANIFEST_DIR")`, which rules_rust
# rejects because it bakes an absolute build path into the binary. Nothing here
# needs the check -- the generated sources are consumed directly -- and the
# Cargo build in krabka-protocol still runs it.
crate.annotation(
    crate = "crabka-protocol",
    gen_build_script = "off",
    strip_prefix = "crates/protocol",
    workspace_cargo_toml = "Cargo.toml",
)

# datafusion-common's `test_util` locates datafusion's test-data submodule
# through `env!("CARGO_MANIFEST_DIR")`, and the module is not feature-gated, so
# that lands in every build of the library. `env!` bakes the absolute build
# directory into the artifact, which the sandboxed build rejects outright: the
# same sources would produce different bytes on different machines. The patch
# reads the variable at run time instead, which is where the only caller -- a
# test helper -- needs it, and which Cargo sets for test binaries anyway.
crate.annotation(
    crate = "datafusion-common",
    patch_args = ["-p1"],
    patches = ["//bazel/patches:datafusion-common-manifest-dir.patch"],
)
crate.annotation(
    crate = "cargo-mutants",
    gen_binaries = ["cargo-mutants"],
    repositories = ["mutants"],
)
use_repo(crate, "crates", "mutants")
